# ============================================================================
# Converge AI configuration.  Copy this file to ".env" and edit.
# Never commit real API keys.  Every value below is optional - the app starts
# without any of them and tells you in the UI exactly which capabilities are off.
# ============================================================================

# ---------------------------------------------------------------------------
# LLM (relationship judgement, synthesis, Q&A, optional vision)
#   none               -> offline extractive mode (no generated prose; clearly labelled in the report)
#   anthropic          -> Anthropic Messages API
#   openai_compatible  -> any OpenAI-style /chat/completions endpoint: OpenAI, Groq, OpenRouter,
#                         Google Gemini (OpenAI-compat endpoint), Ollama / LM Studio / vLLM (local), ...
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Only needed for openai_compatible (or to override the Anthropic URL). Examples:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      http://localhost:11434/v1         (no key needed; set LLM_API_KEY=ollama)
LLM_BASE_URL=
# Set true only if your model accepts images (used to describe images / video frames in addition to OCR).
LLM_VISION=false
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4
# Minimum seconds between LLM calls - raise this on free tiers with tight rate limits (e.g. 2.5).
LLM_MIN_INTERVAL_SECONDS=0
# Max pairs of statements sent to the LLM for relationship judgement per run (rest use heuristics).
LLM_MAX_PAIRS=300
# Rough character budget of source material per synthesis prompt.
LLM_CONTEXT_CHARS=24000

# ---------------------------------------------------------------------------
# Embeddings
#   auto                   -> sentence-transformers if installed and the model is available, else TF-IDF fallback
#   sentence-transformers  -> require it (fails with a clear message if unavailable)
#   api                    -> OpenAI-compatible /embeddings endpoint
#   tfidf                  -> lexical fallback (works offline; weaker at detecting paraphrases)
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# ---------------------------------------------------------------------------
# Audio / video transcription
#   auto  -> faster-whisper if installed, else the API below if configured, else disabled
#   local -> faster-whisper     api -> OpenAI-compatible /audio/transcriptions     none -> disabled
# ---------------------------------------------------------------------------
TRANSCRIBE_PROVIDER=auto
WHISPER_MODEL=base
# Example for Groq:  base https://api.groq.com/openai/v1   model whisper-large-v3-turbo
TRANSCRIBE_API_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# ---------------------------------------------------------------------------
# OCR / video
# ---------------------------------------------------------------------------
OCR_ENABLED=true
OCR_LANG=eng
VIDEO_MAX_FRAMES=8

# ---------------------------------------------------------------------------
# Server / safety
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_UNITS=4000
# Website extraction blocks private/loopback addresses (SSRF protection). Only enable on a trusted local machine.
ALLOW_PRIVATE_URLS=false
